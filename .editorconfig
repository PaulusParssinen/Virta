root = true

[*]
indent_style = space
charset=utf-8
end_of_line = lf

[*.{xml,csproj,slnx,props}]
indent_size = 2

[*.cs]
indent_size = 4
tab_width = 4

dotnet_separate_import_directive_groups = true
dotnet_sort_system_directives_first = true

csharp_empty_block_style = together_same_line
csharp_preserve_single_line_blocks = true
